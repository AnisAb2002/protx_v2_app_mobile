<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey"
    tools:context=".Commander"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/layout_up"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="40dp"
        tools:ignore="UselessParent">

        <ImageButton
            android:id="@+id/retourBouton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:backgroundTint="@color/grey"
            android:contentDescription="@string/bouton_retourner"
            app:srcCompat="@drawable/arrow_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/titreLangue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:layout_marginBottom="15dp"
            android:text="@string/passer_commande"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@+id/layout_up"
        android:layout_marginVertical="50dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="30dp">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="@string/nom"
                android:labelFor="@+id/nomEditText"
                android:textSize="15sp"
                android:textColor="@color/white"/>
            <EditText
                android:id="@+id/nomEditText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:autofillHints=""
                android:inputType="text"
                android:background="@color/lightGrey"
                android:paddingHorizontal="8dp"
                android:textColor="@color/white"
                android:layout_marginBottom="5dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="30dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="@string/prenom"
                android:labelFor="@+id/prenomEditText"
                android:textSize="15sp"
                android:textColor="@color/white"/>
            <EditText
                android:id="@+id/prenomEditText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:autofillHints=""
                android:inputType="text"
                android:background="@color/lightGrey"
                android:paddingHorizontal="8dp"
                android:textColor="@color/white"
                android:layout_marginBottom="5dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="30dp">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="@string/adresse"
                android:labelFor="@+id/adresseEditText"
                android:textSize="15sp"
                android:textColor="@color/white"/>
            <EditText
                android:id="@+id/adresseEditText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:autofillHints=""
                android:inputType="text"
                android:background="@color/lightGrey"
                android:paddingHorizontal="8dp"
                android:textColor="@color/white"
                android:layout_marginBottom="5dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="30dp">
            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="@string/num_tel"
                android:labelFor="@+id/phoneEditText"
                android:textSize="15sp"
                android:textColor="@color/white"/>
            <EditText
                android:id="@+id/phoneEditText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:autofillHints=""
                android:inputType="phone"
                android:maxLength="15"
                android:textColor="@color/white"
                android:background="@color/lightGrey"
                android:paddingHorizontal="8dp"
                android:layout_marginBottom="5dp"/>
        </LinearLayout>

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:ignore="UselessParent"
        android:layout_alignParentBottom="true"
        android:elevation="1dp"
        android:background="@color/grey">

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            android:id="@+id/boutonConfirmer"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="20dp"
            android:textColor="@color/grey"
            android:textSize="12sp"
            android:text="@string/confirmation"/>

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/red"
            android:id="@+id/boutonAnnuler"
            android:layout_below="@+id/boutonConfirmer"
            android:layout_marginHorizontal="4dp"
            android:layout_marginVertical="3dp"
            android:textColor="@color/grey"
            android:textSize="12sp"
            android:text="@string/annuler"/>
    </RelativeLayout>
</RelativeLayout>