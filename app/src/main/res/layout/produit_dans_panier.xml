<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginVertical="4dp"
    android:paddingVertical="15dp"
    android:background="@drawable/rounded_bg"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/imageProduit"
        android:layout_width="170dp"
        android:layout_height="210dp"
        android:contentDescription="@string/produit_image"
        android:src="@drawable/produit_01"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:paddingEnd="50dp">

        <TextView
            android:id="@+id/nomProduit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/produit_nom"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp"
            android:textColor="@color/grey" />
        <TextView
            android:id="@+id/poidsProduit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1500g"
            android:textSize="16sp"
            android:layout_marginBottom="3dp"
            android:textColor="@color/grey" />
        <TextView
            android:id="@+id/categorieProduit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mass / Gainer"
            android:textSize="16sp"
            android:textColor="@color/grey" />
        <TextView
            android:id="@+id/prixProduit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8.00"
            android:textSize="16sp"
            android:layout_marginBottom="5dp"
            android:textColor="@color/grey" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/lightGrey"
                android:id="@+id/diminuerQntButton"
                android:layout_marginHorizontal="4dp"
                android:textColor="@color/white"
                android:layout_weight="3"
                android:textSize="13sp"
                android:text="@string/moins"
                android:labelFor="@+id/quantiteEditText"/>

            <EditText
                android:id="@+id/quantiteEditText"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:autofillHints="0"
                android:layout_weight="4"
                android:background="@color/white"
                android:paddingHorizontal="5dp"
                android:paddingVertical="5dp"
                android:inputType="number"
                android:textColor="@color/grey"/>

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/lightGrey"
                android:layout_weight="3"
                android:id="@+id/ajouterQntButton"
                android:layout_marginHorizontal="4dp"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:text="@string/plus"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/boutonSupprimer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@string/vouloir_supprimer"
            app:srcCompat="@drawable/delete_24"
            app:tint="@color/grey"
            android:backgroundTint="@color/red" />
    </LinearLayout>
</LinearLayout>