<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/grey">


    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/nav"
        android:elevation="2dp"
        android:background="@color/lightGrey">
        <ImageButton
            android:id="@+id/rechercherBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="5dp"
            android:contentDescription="@string/recherchebouton"
            app:srcCompat="@drawable/search_24"
            app:tint="@color/grey"
            android:backgroundTint="@color/white"/>
    </RelativeLayout>

    <TextView
        android:id="@+id/produits_desc_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/nav"
        android:gravity="center"
        android:textSize="15sp"
        android:paddingHorizontal="20dp"
        android:textColor="@color/white"
        android:text=""/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:background="@color/lightGrey"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/assistanceBtn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="@string/assistance"
            app:srcCompat="@drawable/question_24"
            app:tint="@color/grey"
            android:layout_weight="1"
            android:backgroundTint="@color/white"/>


        <ImageButton
            android:id="@+id/profilBtn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="@string/profil"
            app:srcCompat="@drawable/account_24"
            app:tint="@color/grey"
            android:layout_weight="1"
            android:backgroundTint="@color/white"/>


        <ImageButton
            android:id="@+id/boutonPanier"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="@string/ajouter_au_panier"
            app:srcCompat="@drawable/cart_24"
            app:tint="@color/grey"
            android:backgroundTint="@color/white"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/nav"
        android:orientation="horizontal"
        android:paddingBottom="60dp"
        android:contentDescription="@string/produits">

        <LinearLayout
            android:id="@+id/containerProduits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"/>

    </ScrollView>




</RelativeLayout>